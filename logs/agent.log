builtins.input = lambda prompt: "y"

from core.agent import FolderAgent

def run_safe_test():
    """Run a safe data analyst test with output isolation."""
    print("--- Running Safe Data Analyst Test ---")

    # Create an isolated output directory
    output_dir = Path(r"c:\Users\steph\Documents\Lab\experiment801\tests\playground\analyst_output")
    output_dir.mkdir(parents=True, exist_ok=True)

    agent = FolderAgent(
        model_name="phi4:latest",
        capabilities_root=r"c:\Users\steph\Documents\Lab\experiment801\capabilities"
    )

    # Prompt for data analysis task
    prompt = (
        f"You are a Data Analyst. Perform an Exploratory Data Analysis on C:\\Users\\steph\\Documents\\Lab\\experiment801\\tests\\housing.csv.\n\n"
        "CRITICAL INSTRUCTIONS:\n"
        "1. Write a SINGLE Python script using pandas and matplotlib.\n"
        "2. Find the top 3 most correlated features with median_house_value.\n"
        "3. Generate 3 distinct charts (e.g., histogram, scatter plot, correlation matrix).\n"
        "4. You MUST physically save the charts using `plt.savefig()` to this exact directory: {output_dir}\n"
        "5. Write your final report."
    )

    print(f"User:\n{prompt}\n")
    print("Processing (this may take a minute)...\n")

    try:
        result = agent.execute(prompt)

        # Write the final JSON/String output of the agent to a file
        report_path = output_dir / "final_report.txt"
        with open(report_path, "w", encoding="utf-8") as f:
            f.write(str(result))

        print(f"SUCCESS! Output successfully caught and saved.")
        print(f"Check {output_dir} for the final_report.txt and generated charts.")

    except Exception as e:
        print(f"\nExecution failed with error: {e}")

if __name__ == "__main__":
    run_safe_test()
```


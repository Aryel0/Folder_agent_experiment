def calculate_time(distance_km, pace_kmh):
    """
    Calculate the time in hours to cover a given distance at a specific pace.
    
    Parameters:
    distance_km (float): The total distance in kilometers.
    pace_kmh (float): The speed in kilometers per hour.

    Returns:
    float: Time in hours to cover the distance at the given pace.

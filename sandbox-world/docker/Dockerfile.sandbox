# Dockerfile for AI Agent Secure Sandbox & Simulated World
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/agent \
    LANG=C.UTF-8

# Install essential CLI tools and cleanup apt cache
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    curl \
    jq \
    file \
    grep \
    sed \
    gawk \
    findutils \
    tar \
    gzip \
    procps \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Dedicated non-root user (UID: 1000, GID: 1000)
RUN groupadd -g 1000 agent && \
    useradd -u 1000 -g agent -m -d /home/agent -s /bin/bash agent

# Create isolated directories and set strict permissions
RUN mkdir -p /workspace /home/agent && \
    chown -R agent:agent /workspace /home/agent && \
    chmod 750 /home/agent && \
    chmod 755 /workspace

# Install common Python utility packages
RUN pip install --no-cache-dir \
    pydantic \
    requests \
    numpy

WORKDIR /workspace
USER agent:agent

CMD ["sleep", "infinity"]
